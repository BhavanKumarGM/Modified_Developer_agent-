# Copy this file to .env and adjust values as needed

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# Server settings — 127.0.0.1 only by default. This backend has no
# authentication; only set HOST=0.0.0.0 if you understand that means anyone
# on your network can read/write/delete files in your projects.
HOST=127.0.0.1
PORT=8000

# Preview port range for Vite dev servers
PREVIEW_PORT_START=3100
PREVIEW_PORT_END=3200

# Max ZIP upload size in MB
MAX_ZIP_SIZE_MB=100
